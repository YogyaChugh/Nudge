{
  "ir": 1,
  "app": "Nudge",
  "id": "com.nudgeboard.app",
  "desc": "Free open infinite whiteboard with real-time collaboration",
  "start": "Login",
  "types": {
    "Board": {
      "fields": {
        "id": "string",
        "title": "string",
        "owner": "string",
        "createdAt": "string",
        "updatedAt": "string"
      }
    },
    "User": {
      "fields": {
        "id": "string",
        "name": "string",
        "email": "string",
        "avatar": "string"
      }
    }
  },
  "state": {
    "user": { "type": "User?" },
    "boards": { "type": "list<Board>", "init": [] },
    "currentBoard": { "type": "Board?" },
    "theme": { "type": "string", "init": "\"system\"" }
  },
  "screens": [
    "login.screen.json",
    "home.screen.json",
    "board.screen.json",
    "settings.screen.json"
  ],
  "flows": [
    { "flow": "newBoard", "desc": "Create a new whiteboard", "nodes": { "n1": { "k": "action", "op": "nav", "to": "Board" } }, "seq": ["n1"] },
    { "flow": "openHome", "desc": "Go to home", "nodes": { "n1": { "k": "action", "op": "nav", "to": "Home" } }, "seq": ["n1"] },
    { "flow": "openSettings", "desc": "Go to settings", "nodes": { "n1": { "k": "action", "op": "nav", "to": "Settings" } }, "seq": ["n1"] },
    { "flow": "goBack", "desc": "Go back", "nodes": { "n1": { "k": "action", "op": "nav", "to": "Home" } }, "seq": ["n1"] }
  ]
}